# Copy this file to .env and fill in your key. Never commit .env.
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Which grader to use: "gemini" (real) or "fake" (offline, tests only)
GRADER=gemini

# Flask session signing key. Change this for any real deployment.
SECRET_KEY=dev-only-change-me

# Minutes of inactivity before an instructor session expires (SS 4.3.3)
SESSION_TIMEOUT_MINUTES=30

# Student responses sent per AI call. Keeps us inside free-tier rate limits.
GRADING_BATCH_SIZE=10

# Reject uploads with more rows than this
MAX_ROWS=500

# OpenAI (paid) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude (paid) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# DeepSeek (paid, low cost) - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
